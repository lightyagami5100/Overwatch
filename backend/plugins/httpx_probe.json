{
  "name": "httpx_probe",
  "display_name": "HTTPx Probe",
  "category": "Recon",
  "speed": "fast",
  "danger_level": "safe",
  "entity_type": ["DOMAIN", "IP"],
  "command": "httpx --no-verify --follow-redirects --timeout 5 http://{target}",
  "timeout": 15,
  "description": "HTTP probe — fetches response headers, status codes, and server info from the target",
  "runner": "native"
}
